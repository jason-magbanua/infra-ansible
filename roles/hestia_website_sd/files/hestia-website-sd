#!/usr/bin/env python3
# Managed by Ansible — do not edit by hand
# Publishes the live, non-suspended Hestia web domains for Prometheus:
#   targets.json  Prometheus http_sd format, one target per domain
# Suspended users and suspended domains are left out, so a suspension drops the
# site from monitoring within one cron interval.
import json, os, subprocess, sys, tempfile

OUT = sys.argv[1]
env = dict(os.environ, HESTIA="/usr/local/hestia", PATH=os.environ["PATH"] + ":/usr/local/hestia/bin")


def hestia(*args):
    return json.loads(subprocess.check_output(args, env=env))


targets = []
for user, info in sorted(hestia("v-list-users", "json").items()):
    if info.get("SUSPENDED") == "yes":
        continue
    for domain, d in sorted(hestia("v-list-web-domains", user, "json").items()):
        if d.get("SUSPENDED") == "yes":
            continue
        scheme = "https" if d.get("SSL") == "yes" else "http"
        targets.append({"targets": [f"{scheme}://{domain}"],
                        "labels": {"user": user, "site": domain, "scheme": scheme}})


def write(name, content):
    fd, tmp = tempfile.mkstemp(dir=OUT)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chmod(tmp, 0o644)
    os.replace(tmp, os.path.join(OUT, name))


write("targets.json", json.dumps(targets, indent=1) + "\n")
