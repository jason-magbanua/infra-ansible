# Managed by Ansible — do not edit by hand
# Hot-reloaded by Traefik via file provider watch: true
http:
  routers:
    prometheus:
      rule: "Host(`prometheus.{{ traefik_domain }}`)"
      entryPoints:
        - websecure
      service: prometheus
      tls:
        certResolver: cloudflare
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"

  services:
    prometheus:
      loadBalancer:
        servers:
          - url: "http://{{ prometheus_ip }}:{{ prometheus_port }}"
