# Managed by Ansible — do not edit by hand
[Unit]
Description=Prometheus Blackbox Exporter (public prober)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ blackbox_exporter_user }}
Group={{ blackbox_exporter_user }}
ExecStart=/usr/local/bin/blackbox_exporter \
  --config.file={{ blackbox_exporter_config_dir }}/blackbox.yml \
  --web.listen-address={{ blackbox_exporter_public_listen }}

Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
