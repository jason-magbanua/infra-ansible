     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_http_status_code{site=~\"$site\",vantage=~\"$vantage\"}",
     "refId": "B",
     "legendFormat": "",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_duration_seconds{site=~\"$site\",vantage=~\"$vantage\"}",
     "refId": "C",
     "legendFormat": "",
     "format": "table",
     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(probe_ssl_earliest_cert_expiry{site=~\"$site\",vantage=~\"$vantage\"}-time())/86400",
     "refId": "D",
     "legendFormat": "",
