    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Soonest cert expiry",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min((probe_ssl_earliest_cert_expiry{site=~\"$site\",vantage=~\"$vantage\"}-time())/86400)",
     "refId": "A",
     "legendFormat": "",
     "format": "time_series",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 30
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "description": "Only https targets report a certificate"
  },
  {
