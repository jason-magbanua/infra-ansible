     "instant": true,
     "range": false
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "avg_over_time(probe_success{site=~\"$site\",vantage=~\"$vantage\"}[$__range])*100",
     "refId": "E",
     "legendFormat": "",
     "format": "table",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Up"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "0": {
            "text": "DOWN",
            "color": "red"
           },
           "1": {
            "text": "UP",
            "color": "green"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Response"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Uptime %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "decimals",
        "value": 2
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Cert days"
      },
      "properties": [
       {
        "id": "decimals",
        "value": 0
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "red",
           "value": null
          },
          {
           "color": "orange",
           "value": 14
          },
          {
           "color": "green",
           "value": 30
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "sortBy": [
     {
      "displayName": "Site",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "job": true,
       "__name__": true,
       "scheme": true,
       "instance": true
      },
      "renameByName": {
       "site": "Site",
       "user": "Hestia user",
       "vantage": "Vantage",
       "Value #A": "Up",
       "Value #B": "HTTP",
       "Value #C": "Response",
       "Value #D": "Cert days",
       "Value #E": "Uptime %"
      },
      "indexByName": {
       "site": 0,
       "vantage": 1,
       "user": 2,
       "Value #A": 3,
       "Value #B": 4,
       "Value #C": 5,
       "Value #E": 6,
       "Value #D": 7
      }
     }
    }
   ]
