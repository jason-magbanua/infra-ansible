    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{site=~\"$site\",vantage=~\"$vantage\"}",
     "refId": "A",
     "legendFormat": "{{site}} ({{vantage}})",
     "format": "time_series",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
