        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up{job=~\"node_exporter|windows_exporter\"}==0) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(100 - avg by(instance)(rate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\"}[$__rate_interval]))*100)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(100*(1-node_memory_MemAvailable_bytes{job=\"node_exporter\"}/node_memory_MemTotal_bytes{job=\"node_exporter\"}))",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Fullest disk",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max by(instance)(100*(1-node_filesystem_avail_bytes{job=\"node_exporter\",mountpoint=~\"/|/usr/lib/live/mount/persistence\",fstype!~\"tmpfs|overlay|squashfs\"}/node_filesystem_size_bytes{job=\"node_exporter\",mountpoint=~\"/|/usr/lib/live/mount/persistence\",fstype!~\"tmpfs|overlay|squashfs\"})))",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Down scrape targets",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(up==0) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 1,
      "type": "table",
      "title": "Hosts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"node_exporter\"}",
          "refId": "Up",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time()-node_boot_time_seconds{job=\"node_exporter\"}",
          "refId": "Uptime",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by(instance)(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\"})",
          "refId": "Cores",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - avg by(instance)(rate(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\"}[$__rate_interval]))*100",
          "refId": "CPU",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100*(1-node_memory_MemAvailable_bytes{job=\"node_exporter\"}/node_memory_MemTotal_bytes{job=\"node_exporter\"})",
          "refId": "Mem",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by(instance)(100*(1-node_filesystem_avail_bytes{job=\"node_exporter\",mountpoint=~\"/|/usr/lib/live/mount/persistence\",fstype!~\"tmpfs|overlay|squashfs\"}/node_filesystem_size_bytes{job=\"node_exporter\",mountpoint=~\"/|/usr/lib/live/mount/persistence\",fstype!~\"tmpfs|overlay|squashfs\"}))",
          "refId": "Disk",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1{job=\"node_exporter\"}/on(instance) count by(instance)(node_cpu_seconds_total{job=\"node_exporter\",mode=\"idle\"})",
          "refId": "Load",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(instance)(rate(node_network_receive_bytes_total{job=\"node_exporter\",device!~\"lo|veth.*|fwbr.*|fwpr.*|fwln.*|tap.*|docker.*|br-.*\"}[$__rate_interval]))",
          "refId": "RX",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by(instance)(rate(node_network_transmit_bytes_total{job=\"node_exporter\",device!~\"lo|veth.*|fwbr.*|fwpr.*|fwln.*|tap.*|docker.*|br-.*\"}[$__rate_interval]))",
          "refId": "TX",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_uname_info{job=\"node_exporter\"}",
          "refId": "Kernel",
          "legendFormat": "{{instance}}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "__name__": true,
              "domainname": true,
              "machine": true,
              "nodename": true,
              "sysname": true,
              "version": true,
              "Time Up": true,
              "Time #Up": true,
              "job Up": true,
              "job #Up": true,
              "Value #Kernel": true,
              "Time Uptime": true,
              "Time #Uptime": true,
              "job Uptime": true,
              "job #Uptime": true,
              "Time Cores": true,
              "Time #Cores": true,
              "job Cores": true,
              "job #Cores": true,
              "Time CPU": true,
              "Time #CPU": true,
              "job CPU": true,
              "job #CPU": true,
              "Time Mem": true,
              "Time #Mem": true,
              "job Mem": true,
              "job #Mem": true,
              "Time Disk": true,
              "Time #Disk": true,
              "job Disk": true,
              "job #Disk": true,
              "Time Load": true,
              "Time #Load": true,
              "job Load": true,
              "job #Load": true,
              "Time RX": true,
              "Time #RX": true,
              "job RX": true,
              "job #RX": true,
              "Time TX": true,
              "Time #TX": true,
              "job TX": true,
              "job #TX": true,
              "Time Kernel": true,
              "Time #Kernel": true,
              "job Kernel": true,
              "job #Kernel": true
            },
            "renameByName": {
              "instance": "Host",
              "Value #Up": "Status",
              "Value #Uptime": "Uptime",
              "Value #Cores": "Cores",
              "Value #CPU": "CPU %",
              "Value #Mem": "Memory %",
              "Value #Disk": "Disk %",
              "Value #Load": "Load / core",
              "Value #RX": "Net RX",
              "Value #TX": "Net TX",
              "release": "Kernel"
            },
            "indexByName": {
              "instance": 0,
              "Value #Up": 1,
              "Value #Uptime": 2,
              "Value #Cores": 3,
              "Value #CPU": 4,
              "Value #Mem": 5,
              "Value #Disk": 6,
              "Value #Load": 7,
              "Value #RX": 8,
              "Value #TX": 9,
              "release": 10
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Host"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
